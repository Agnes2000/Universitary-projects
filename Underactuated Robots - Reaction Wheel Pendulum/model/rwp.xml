<mujoco model="reaction_wheel_pendulum">

  <option gravity="0 0 -9.8" integrator="RK4" timestep="0.001"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8"/>
  </visual>

  <worldbody>
    <body name="base" pos="0 0 0.3">
  <body name="pendulum" pos="0 0 0">
    <joint name="q1" type="hinge" axis="0 1 0" pos="0 0 0" limited="false" damping="0.0"/>
    <geom name="rod" type="capsule"
          fromto="0 0 0  0 0 0.4"
          size="0.015" rgba="0.2 0.4 0.8 1" mass="0.3"/>

    <body name="disk" pos="0 0 0.4">
      <joint name="q2" type="hinge" axis="0 1 0" pos="0 0 0" limited="false" damping="0.0"/>
      <geom name="disk_geom" type="cylinder"
            pos="0 0 0" euler="90 0 0"
            size="0.12 0.01" rgba="0.8 0.3 0.2 1" mass="0.3"/>

      <geom name="wheel_tag" type="box" size="0.005 0.08 0.005"
        pos="0.08 0 0" rgba="1 0 0 1"
        contype="0" conaffinity="0" mass="0"/>
        
    </body>
  </body>
</body>
  </worldbody>

  <actuator>
    <!-- Solo il disco è attuato -->
    <motor name="motor2" joint="q2"
           gear="1" ctrllimited="true" ctrlrange="-3 3"/>
  </actuator>

  <sensor>
    <jointpos name="q1_pos" joint="q1"/>
    <jointpos name="q2_pos" joint="q2"/>
    <jointvel name="dq1" joint="q1"/>
    <jointvel name="dq2" joint="q2"/>
  </sensor>

</mujoco>